# keystore.properties lives in this android/ folder (next to this example).
# storeFile is relative to android/app/.
# From android/app, create the key once and keep it offline:
#   keytool -genkeypair -v -keystore fikr-release.keystore -alias fikr -keyalg RSA -keysize 2048 -validity 10000
storeFile=fikr-release.keystore
storePassword=CHANGE_ME
keyAlias=fikr
keyPassword=CHANGE_ME
