# Zinat Al-Haya School Management - Environment Configuration Template
# Copy this file to .env and update the values

# Application
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=school_admin
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=school_management

# JWT Configuration — generate with: openssl rand -base64 48
# Must be ≥32 chars and must NOT reuse any previously leaked secret.
JWT_SECRET=GENERATE_ME_openssl_rand_base64_48_characters_min
JWT_EXPIRES_IN=24h
# How long after expiry POST /auth/refresh still accepts the old access token (seconds).
JWT_REFRESH_GRACE_SECONDS=7200
JWT_REFRESH_SECRET=GENERATE_ME_another_openssl_rand_base64_48_chars
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# CORS Configuration — comma-separated allowlist (required in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CORS_CREDENTIALS=true
# Used to make relative school logos absolute in emails (first CORS origin is the fallback).
# Local:
# PUBLIC_APP_URL=http://localhost:5173
# Production (Railway frontend public URL — required for FIKR logo in system emails):
# PUBLIC_APP_URL=https://YOUR-FRONTEND.up.railway.app
# Public API origin (Infobip WhatsApp fetches letter attachments from here):
# PUBLIC_API_URL=https://YOUR-BACKEND.up.railway.app

# Logging
LOG_LEVEL=debug

# Security
BCRYPT_SALT_ROUNDS=12
# Off by default. Set true only on a local machine — never in production.
ENABLE_DEBUG_ENDPOINTS=false

# Outbound email — Infobip HTTPS (production / Railway). SMTP is a local fallback only.
# Infobip portal: API keys + your base URL (https://xxxxx.api.infobip.com).
# Verify fikr.om as a sender domain, then set EMAIL_FROM to a mailbox on that domain.
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_API_KEY=
EMAIL_FROM=noreply@fikr.om
# Optional — SMS sender ID (TRA-approved in Oman when you go live)
# INFOBIP_SMS_FROM=FIKR
# WhatsApp Business number in digits, no plus. Leave empty until Meta approves the number.
# INFOBIP_WHATSAPP_FROM=968xxxxxxxx
# Also send the SMS body on WhatsApp when a phone is on the notification:
# INFOBIP_WHATSAPP_MIRROR_SMS=false
#
# Local-only SMTP fallback (ignored when INFOBIP_API_KEY is set):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Temporary: subscribe OTP is 000000 and email is skipped. Set off when Infobip email is live.
# SIGNUP_OTP_FIXED_CODE=000000
# SIGNUP_OTP_FIXED_CODE=off

# Error alert emails — stack traces for API 5xx and SPA crash reports (needs Infobip or SMTP above).
# Set ERROR_ALERT_ENABLED=false to disable. Default inbox is ssam007@hotmail.com.
ERROR_ALERT_ENABLED=true
ERROR_ALERT_EMAIL=ssam007@hotmail.com
# Landing consult form (“Continue to subscribe”). Falls back to ERROR_ALERT_EMAIL.
# PLATFORM_INQUIRY_EMAIL=ssam007@hotmail.com
# ERROR_ALERT_MIN_STATUS=500
# ERROR_ALERT_COOLDOWN_MS=300000
# ERROR_ALERT_MAX_PER_HOUR=30

# SMS — optional. Default `log` writes to the backend log (no gateway).
# Infobip: SMS_PROVIDER=infobip (uses INFOBIP_API_KEY + INFOBIP_SMS_FROM).
# Or SMS_PROVIDER=http and SMS_HTTP_URL to POST { to, body }.
SMS_PROVIDER=log
# SMS_PROVIDER=infobip
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=

# Push (mobile app later) — device tokens / FCM are not wired yet.
# All events still go through NotificationDispatcherService so push can attach later.


# Application Info
APP_NAME=Zinat Al-Haya School Management
APP_VERSION=1.0.0
APP_DESCRIPTION=Complete bilingual school management system for kindergarten

# Thawani Checkout — UAT now; swap URL + keys for production later.
# Official Thawani UAT keys (public test merchant). Production keys come from the merchant portal.
THAWANI_BASE_URL=https://uatcheckout.thawani.om
THAWANI_SECRET_KEY=rRQ26GcsZzoEhbrP2HZvLYDbn9C9et
THAWANI_PUBLISHABLE_KEY=HGvTMLDssJghr9tlN9gr4DVYt0qyBy

# Daily.co — online class video rooms (https://dashboard.daily.co/developers)
# Leave unset to disable online session creation (API returns a clear error).
# Local: may be in `.env` or `.env.local` next to this backend (see ConfigModule envFilePath).
# Railway: set DAILY_API_KEY on the backend service (Variables), not only on the frontend.
DAILY_API_KEY=5df43523d29f8281be1288ffcc01c9b31bd6c81a652882d1d40095d6441c5cf6

# Public /demo live cursor — issues a short JWT for the demo school (iframe sessionStorage only).
# Emails fall back to the first admin / parent at that school until fikr-demo.com accounts exist.
# DEMO_SCHOOL_SLUG=zinat-al-haya
# DEMO_STAFF_EMAIL=admin@fikr-demo.com
# DEMO_PARENT_EMAIL=parent@fikr-demo.com
# DEMO_JWT_EXPIRES_IN=20m
