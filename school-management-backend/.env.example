# Zinat Al-Haya School Management - Environment Configuration Template
# Copy this file to .env and update the values

# Application
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=school_admin
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=school_management

# JWT Configuration (Generate secure random strings for production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=debug

# Security
BCRYPT_SALT_ROUNDS=12

# Application Info
APP_NAME=Zinat Al-Haya School Management
APP_VERSION=1.0.0
APP_DESCRIPTION=Complete bilingual school management system for kindergarten

# Daily.co — online class video rooms (https://dashboard.daily.co/developers)
# Leave unset to disable online session creation (API returns a clear error).
# Local: may be in `.env` or `.env.local` next to this backend (see ConfigModule envFilePath).
# Railway: set DAILY_API_KEY on the backend service (Variables), not only on the frontend.
DAILY_API_KEY=5df43523d29f8281be1288ffcc01c9b31bd6c81a652882d1d40095d6441c5cf6
